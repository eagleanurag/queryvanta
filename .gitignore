# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cloudflare Workers local state and secrets.
# `.dev.vars` holds REAL OAuth/session secrets for `wrangler dev`
# and must never be committed.
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/

# Records which deployment target the current dist/ was built for.
# Read by scripts/verify-build.mjs and scripts/predeploy-worker.mjs
# so a Pages build can never be uploaded to the Worker.
.qv-build.json

# Generated by server/tests/admin-env.ts. Records the throwaway local
# Worker origin AND a minted session cookie plus the test SESSION_SECRET.
# Regenerate by re-running the harness; never commit.
server/tests/.admin-env.json

# Local review artifact only: `git diff --cached > queryvanta-full-diff.txt`.
queryvanta-full-diff.txt

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Environment files that may contain credentials.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
