{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queryvanta",
  "main": "server/index.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "queryvanta",
      "database_id": "1933e2db-d834-4bbd-9040-6c0abdc6262e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://queryvanta.queryvanta.workers.dev",
    "GITHUB_CLIENT_ID": "Ov23liesFfVbuqjvWt7A",
    "ADMIN_GITHUB_IDS": "22770735"
  }
}
