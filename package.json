{
  "name": "queryvanta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "node scripts/dev.mjs worker",
    "build": "node scripts/build.mjs pages",
    "build:pages": "node scripts/build.mjs pages",
    "build:worker": "node scripts/build.mjs worker",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:worker": "node scripts/predeploy-worker.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "node --experimental-strip-types --test server/tests/secrets.test.ts",
    "test:build": "node --experimental-strip-types --test server/tests/build-target.test.ts",
    "test:merge": "node --experimental-strip-types --test server/tests/catalog-merge.test.ts",
    "test:pkce": "node --experimental-strip-types --test server/tests/pkce.test.ts",
    "test:oauth": "node --experimental-strip-types --test server/tests/oauth-url.test.ts",
    "test:security": "node --experimental-strip-types --test server/tests/boot.test.ts server/tests/security.test.ts",
    "test:worker": "node --experimental-strip-types --test server/tests/worker-assets.test.ts",
    "test:server": "npm run test:build && npm run test:merge && npm run test:pkce && npm run test:oauth && npm run test:unit && npm run test:security && npm run test:worker",
    "test:browser": "playwright test",
    "test": "npm run test:server && npm run test:browser",
    "worker:dev": "wrangler dev",
    "d1:migrate:local": "wrangler d1 execute queryvanta --local --file=migrations/0001_init.sql",
    "d1:migrate": "wrangler d1 execute queryvanta --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.141.0"
  }
}
